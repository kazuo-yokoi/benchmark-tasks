#usda 1.0
(
    defaultPrim = "tea_cup"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tea_cup" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
